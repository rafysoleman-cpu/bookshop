# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/BookShop?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EMAIL_SECRET=replace-with-another-long-random-secret
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Admin Configuration
# Comma-separated list of admin emails. Only these accounts can access the admin panel.
ADMIN_EMAILS=your-admin-email@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/v1/auth/google/callback

# Client URLs
FRONTEND_URL=http://localhost:3001
CLIENT_URL=http://localhost:3001

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Email (Brevo API)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-sender-email@gmail.com
EMAIL_FROM_NAME=BookShop


# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_PRIVATE_KEY=your-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Storage Provider
STORAGE_PROVIDER=imagekit
